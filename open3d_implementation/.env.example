# RunPod Serverless ComfyUI
# Copy to .env and fill locally. Never commit real values.
AI_FILM_RUNS_ROOT=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_GPU_USD_PER_SECOND=0.00097
# Conservative upper bound when the Qwen endpoint can fall back from A100 to H100.
RUNPOD_QWEN_GPU_USD_PER_SECOND=0.00116
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_NETWORK_VOLUME_DATACENTER=EUR-IS-1

# ComfyUI workflow/runtime
# comfyui | gemini | fal
IMAGE_GENERATION_PROVIDER=comfyui
# Validated target: FLUX.2 base generation followed by bounded Qwen semantic edits.
COMFYUI_MODEL_FAMILY=flux2_klein
IMAGE_GENERATION_MAX_ATTEMPTS=4
IMAGE_SEMANTIC_MIN_SCORE=88
IMAGE_MIN_EDGE_SHARPNESS=24
LOCAL_CAST_REFERENCE_MIN_EDGE_SHARPNESS=20
LOCAL_CAST_REFERENCE_MIN_ACTIVE_EDGE_DENSITY=0.005
LOCAL_CAST_REFERENCE_MIN_ACTIVE_EDGE_STRENGTH=30
CAST_BIBLE_RECURRING_MIN_MENTIONS=2
COMFYUI_WORKFLOW_PATH=
COMFYUI_DEFAULT_CHECKPOINT=ai-film-semantic-juggernaut-xl.safetensors
COMFYUI_CHECKPOINT_COMIC_STORYBOOK=ai-film-semantic-juggernaut-xl.safetensors
COMFYUI_CHECKPOINT_CINEMATIC_REALISM=ai-film-cinematic-realism.safetensors
COMFYUI_FLUX2_DIFFUSION_MODEL=flux-2-klein-base-4b.safetensors
COMFYUI_FLUX2_TEXT_ENCODER=qwen_3_4b.safetensors
COMFYUI_FLUX2_VAE=flux2-vae.safetensors
COMFYUI_FLUX2_STEPS=20
COMFYUI_FLUX2_CFG=5.0
# Promote only after the isolated Qwen smoke passes the semantic gate.
COMFYUI_SEMANTIC_REPAIR_BACKEND=qwen_image_edit_2511
COMFYUI_QWEN_EDIT_ENDPOINT_ID=
COMFYUI_QWEN_EDIT_DIFFUSION_MODEL=qwen_image_edit_2511_fp8mixed.safetensors
COMFYUI_QWEN_EDIT_TEXT_ENCODER=qwen_2.5_vl_7b_fp8_scaled.safetensors
COMFYUI_QWEN_EDIT_VAE=qwen_image_vae.safetensors
COMFYUI_QWEN_EDIT_STEPS=40
COMFYUI_CONTROLNET_CANNY_MODEL=controlnet-canny-sdxl-1.0.safetensors
COMFYUI_CONTROLNET_DEPTH_MODEL=controlnet-depth-sdxl-1.0.safetensors
COMFYUI_CONTROL_IMAGE_MODE=semantic_depth
COMFYUI_CONTROLNET_STRENGTH=0.78
# Enable only when the endpoint image includes ComfyUI_IPAdapter_plus.
COMFYUI_IPADAPTER_ENABLED=false
COMFYUI_IPADAPTER_WEIGHT=0.72
# Optional original/licensed style LoRA stored in models/loras on the Network Volume.
COMFYUI_STYLE_LORA_COMIC_STORYBOOK=
COMFYUI_STYLE_LORA_STRENGTH=0.65
COMFYUI_INPAINT_DENOISE=0.85
COMFYUI_QWEN_INPAINT_DENOISE=1.0
COMFYUI_REFINER_ENABLED=false
COMFYUI_REFINER_CHECKPOINT=ai-film-dreamshaper-xl-turbo-sfw.safetensors
COMFYUI_REFINER_SCALE=1.25
COMFYUI_REFINER_DENOISE=0.18
COMFYUI_REFINER_STEPS=6
COMFYUI_RUNPOD_MAX_WAIT_SECONDS=600
COMFYUI_RUNPOD_MAX_QUEUE_SECONDS=900
CAST_REFERENCE_DERIVED_CONCURRENCY=1
CAST_REFERENCE_MAX_ATTEMPTS=1
CAST_REFERENCE_POSE_FAILURE_LIMIT=2
# Lower denoise preserves the canonical face/age; wider reframing needs more freedom.
CAST_REFERENCE_QWEN_DENOISE_THREE_QUARTER=0.95
CAST_REFERENCE_QWEN_DENOISE_PROFILE=0.90
CAST_REFERENCE_QWEN_DENOISE_FULL_BODY=1.0
CAST_REFERENCE_QWEN_DENOISE_EXPRESSION_NEUTRAL=0.35
CAST_REFERENCE_QWEN_DENOISE_EXPRESSION_WARM=0.35
CAST_REFERENCE_QWEN_DENOISE_EXPRESSION_CONCERNED=0.35
RUNPOD_ENDPOINT_PROPAGATION_RETRY_SECONDS=20
COMFYUI_TIMEOUT=180

# Existing pipeline keys go here as needed.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=

# fal.ai managed media pipeline
# FLUX.1 Schnell prioritizes speed and uses prompt + seed conditioning.
# This endpoint does not accept reference images or LoRA adapters.
FAL_FLUX_MODEL_ID=fal-ai/flux/schnell
FAL_FLUX_INFERENCE_STEPS=4
FAL_FLUX_GUIDANCE_SCALE=3.5
FAL_FLUX_ACCELERATION=none
FAL_FLUX_USD_PER_MEGAPIXEL=0.003
# Images without canonical references use Schnell. Any approved canonical
# reference routes generation through Nano Banana Edit.
FAL_REFERENCE_EDIT_MODEL_ID=fal-ai/nano-banana/edit
FAL_REFERENCE_MAX_IMAGES=6
FAL_NANO_BANANA_SAFETY_TOLERANCE=4
FAL_NANO_BANANA_USD_PER_IMAGE=0.039
# Legacy identity providers remain configurable for explicit experiments only.
FAL_INSTANT_CHARACTER_MODEL_ID=fal-ai/instant-character
FAL_INSTANT_CHARACTER_INFERENCE_STEPS=28
FAL_INSTANT_CHARACTER_GUIDANCE_SCALE=3.5
FAL_INSTANT_CHARACTER_SCALE=1.0
FAL_INSTANT_CHARACTER_USD_PER_MEGAPIXEL=0.10
FAL_FLUX_PULID_MODEL_ID=fal-ai/flux-pulid
FAL_FLUX_PULID_INFERENCE_STEPS=20
FAL_FLUX_PULID_GUIDANCE_SCALE=4.0
FAL_FLUX_PULID_TRUE_CFG=1.0
FAL_FLUX_PULID_ID_WEIGHT=1.0
FAL_FLUX_PULID_USD_PER_MEGAPIXEL=0.0333

# runway | fal_kling
VIDEO_GENERATION_PROVIDER=fal_kling
FAL_KLING_MODEL_ID=fal-ai/kling-video/v3/standard/image-to-video
FAL_KLING_CFG_SCALE=0.5
FAL_KLING_USD_PER_SECOND=0.084
FAL_KLING_LIPSYNC_ENABLED=true
FAL_KLING_LIPSYNC_MODEL_ID=fal-ai/kling-video/lipsync/audio-to-video
FAL_KLING_LIPSYNC_USD_PER_SECOND=0.014
FAL_HTTP_TIMEOUT_SECONDS=30
FAL_QUEUE_TIMEOUT_SECONDS=900
FAL_EXECUTION_TIMEOUT_SECONDS=1200
FAL_POLL_INTERVAL_SECONDS=3
FAL_POLL_REQUEST_RETRY_ATTEMPTS=3
# Comma-separated suffix allowlist for downloaded provider artifacts.
FAL_OUTPUT_HOST_SUFFIXES=fal.media,fal.run,storage.googleapis.com

# LLM model routing
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TEXT_TIMEOUT_SECONDS=90
GEMINI_TEXT_RETRY_ATTEMPTS=2
GEMINI_VISION_QA_TIMEOUT_SECONDS=90
GEMINI_IMAGE_TIMEOUT_SECONDS=180
GEMINI_REQUEST_RETRY_ATTEMPTS=2
GEMINI_IMAGE_FAST_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_QUALITY_MODEL=gemini-3-pro-image
GEMINI_IMAGE_USD_PER_IMAGE=0.12
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-5.4-nano
# local keeps private images on-device; gemini and openai send images externally.
IMAGE_SEMANTIC_QA_PROVIDER=local
LOCAL_VISION_QA_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
LOCAL_VISION_QA_REVISION=a7da5b986cb59b408707209984f360a5f4ad7e47
LOCAL_AGE_QA_MODEL=dima806/fairface_age_image_detection
LOCAL_AGE_QA_REVISION=4e02ab8057ea7fd74b1670940995c5dfda3e6ec0
LOCAL_VISION_QA_OFFLINE=false
LOCAL_VISION_QA_LONGEST_EDGE=1024
LOCAL_CAST_IDENTITY_PROFILE_MIN_SIMILARITY=0.65
LOCAL_CAST_IDENTITY_PROFILE_COMPOSITION_MIN_SIMILARITY=0.72
LOCAL_CAST_IDENTITY_THREE_QUARTER_MIN_SIMILARITY=0.75
LOCAL_CAST_IDENTITY_THREE_QUARTER_COMPOSITION_MIN_SIMILARITY=0.80
LOCAL_CAST_IDENTITY_FULL_BODY_MIN_SIMILARITY=0.68
LOCAL_CAST_IDENTITY_EXPRESSION_NEUTRAL_MIN_SIMILARITY=0.84
LOCAL_CAST_IDENTITY_EXPRESSION_WARM_MIN_SIMILARITY=0.88
LOCAL_CAST_IDENTITY_EXPRESSION_CONCERNED_MIN_SIMILARITY=0.84
LOCAL_NARRATIVE_IDENTITY_MIN_SIMILARITY=0.68
LOCAL_NARRATIVE_IDENTITY_MIN_MARGIN=0.08
LOCAL_CAST_REFERENCE_BACKGROUND_MAX_VARIATION=0.03
LOCAL_CAST_THREE_QUARTER_MAX_COMPOSITION_SIMILARITY=0.97
IMAGE_SEMANTIC_QA_ALLOW_EXTERNAL_FALLBACK=false
IMAGE_SEMANTIC_QA_FALLBACK_PROVIDER=openai
OPENAI_VISION_QA_MODEL=gpt-5.4-mini

# Cost/quota guardrails for local curation UI
AI_FILM_COST_WARN_USD=1.00
AI_FILM_COST_LIMIT_USD=2.00
AI_FILM_RUNPOD_COST_LIMIT_USD=0.75
AI_FILM_RUNPOD_HARD_COST_GUARD_ENABLED=true
AI_FILM_RUNPOD_HARD_BUDGET_USD=4.00
AI_FILM_RUNPOD_MIN_BALANCE_USD=3.00
AI_FILM_RUNPOD_MAX_WORKERS_ALLOWED=1
AI_FILM_RUNPOD_JOB_RESERVATION_SECONDS=420
AI_FILM_RUNWAY_COST_LIMIT_USD=1.50
AI_FILM_FAL_COST_LIMIT_USD=2.00
AI_FILM_ELEVENLABS_CHAR_LIMIT_PER_RUN=1200
